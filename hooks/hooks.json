{
  "description": "Flow gates - TDD on Write/Edit, and a fast-test check before git commit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-tdd-gate.mjs\"",
            "timeout": 10,
            "statusMessage": "Flow TDD gate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-commit-gate.mjs\"",
            "if": "Bash(git commit *)",
            "timeout": 120,
            "statusMessage": "Flow commit gate"
          }
        ]
      }
    ]
  }
}
