{
  "description": "Flow gates - PLAN and owner confirmation before code, TDD on writes, citations and fast tests before a commit, and no push without the owner. Wired on Write, Edit, Bash and PowerShell.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-plan-gate.mjs\"",
            "timeout": 10,
            "statusMessage": "Flow plan gate"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-tdd-gate.mjs\"",
            "timeout": 10,
            "statusMessage": "Flow TDD gate"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-plan-gate.mjs\"",
            "timeout": 10,
            "statusMessage": "Flow push gate"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-commit-gate.mjs\"",
            "if": "Bash(git commit *)",
            "timeout": 120,
            "statusMessage": "Flow commit gate"
          }
        ]
      }
    ]
  }
}
