{
  "description": "Flow TDD gate - denies Write/Edit on a guarded source file when no test covering it exists.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-tdd-gate.mjs\"",
            "timeout": 10,
            "statusMessage": "Flow TDD gate"
          }
        ]
      }
    ]
  }
}
